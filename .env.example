# Tina Cloud credentials.
# NOT required for local development (`pnpm dev` runs Tina in local mode).
# Required for production builds (`pnpm build`) and editing via Tina Cloud.
# Copy to `.env.local` and fill in.

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
TINA_SEARCH_TOKEN=

# Branch Tina reads content from. Defaults to "main" if unset.
VERCEL_GIT_COMMIT_REF=
